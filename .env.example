# Copy this file to `.env` and fill in your own values. Never commit `.env`.

# Required: bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Optional: command prefix (default "~")
BOT_PREFIX=~

# Optional: enables the GIF commands. Get a key at https://developers.giphy.com/
GIPHY_API_KEY=

# Optional: enables the meme commands. Create a "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=python:sugar-discord-bot:v2.0
